NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/agar_events
CLIENT_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# Run npm run setup to generate a random JWT secret. Set the admin values yourself; never commit server/.env.
JWT_SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
TRUST_PROXY=0
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
